#FUSSAREA
#AREADATA
Version      1
Name         Earth Assembly Complex~
Author       Durga~
Ranges       0 0 0 103
Economy      0 31250000
ResetFreq    15
#ENDAREADATA

#MOBILE
Vnum       10100
Keywords   A Delegate~
Short      a newly created A Delegate~
Long       Some god abandoned a newly created A Delegate here.
~
Race       Human~Position   aggressive~
DefPos     aggressive~
Gender     neuter~
Actflags   npc~
Stats1     0 5 0 100 0 0
Stats2     1 6 0
Stats3     1 4 0
Stats4     0 0 0 0 0
Attribs    10 14 13 11 11 16 10 0
Saves      0 0 0 0 0
Speaks     common~
Speaking   common~
#ENDMOBILE

#MOBILE
Vnum       10101
Keywords   Assembly guard~
Short      the Assembly guard~
Long       A guard watches the entrance to the Assembly Hall.
~
Race       Human~Position   aggressive~
DefPos     aggressive~
Gender     neuter~
Actflags   npc sentinel~
Stats1     0 60 0 90 0 0
Stats2     12 10 24
Stats3     1 6 2
Stats4     0 0 0 1 1
Attribs    14 11 12 14 14 10 10 0
Saves      0 0 0 0 0
Speaks     common~
Speaking   common~
#MUDPROG
Progtype  all_greet_prog~
Arglist   100~
Comlist   if council($n)
bow $n
else
say Sorry this area is for council members only.
mpechoat $n The guard escorts you to the west.
mpechoaround $n The guard escorts $n to the west.
mptransfer $n 10118
endif
~
#ENDPROG

#ENDMOBILE

#MOBILE
Vnum       10102
Keywords   checkpoint guard~
Short      a checkpoint guard~
Long       A guard checks for weapons.
~
Race       Human~Position   aggressive~
DefPos     aggressive~
Specfun    spec_customs_weapons~
Gender     neuter~
Actflags   npc sentinel~
Stats1     0 60 0 90 0 0
Stats2     12 10 24
Stats3     1 6 2
Stats4     0 0 0 1 1
Attribs    14 11 12 14 14 10 10 0
Saves      0 0 0 0 0
Speaks     common~
Speaking   common~
#MUDPROG
Progtype  all_greet_prog~
Arglist   100~
Comlist   say Please empty all bags...
mpforce $n get all bag
say .... and backpacks.
mpforce $n get all back
mpforce $n sit
~
#ENDPROG

#MUDPROG
Progtype  act_prog~
Arglist   rises~
Comlist   mpat 10193 drop all
~
#ENDPROG

#MUDPROG
Progtype  act_prog~
Arglist   leaves~
Comlist   mpat 10193 drop all
~
#ENDPROG

#ENDMOBILE

